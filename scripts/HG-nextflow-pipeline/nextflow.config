params {
    samples = '/mnt/roche/resources/datasets/human-genomics/short-read/samples.txt'
    reads = '/mnt/roche/resources/datasets/human-genomics/short-read'
    ref = '/mnt/roche/resources/hg38_ref_genome/Homo_sapiens_assembly38.fasta'
    dbsnp = '/mnt/roche/resources/hg38_ref_genome/Homo_sapiens_assembly38.dbsnp138.vcf.gz'
    indels = '/mnt/roche/resources/hg38_ref_genome/Homo_sapiens_assembly38.known_indels.vcf.gz'
    dbsnp_index = '/mnt/roche/resources/hg38_ref_genome/Homo_sapiens_assembly38.dbsnp138.vcf.gz.tbi'
    indels_index = '/mnt/roche/resources/hg38_ref_genome/Homo_sapiens_assembly38.known_indels.vcf.gz.tbi'
    interval = 'chr17:43041295-43173327'
    joint_method = 'combine'
    outdir = 'results'
}

process {
    cpus = 2
    memory = '10 GB'
    time = '2h'
    errorStrategy = 'ignore'

        withName: 'ALIGNMENT' {
        cpus = 2
        memory = '16 GB'
        time = '2h'
    }

    withName: 'SORT_BAM' {
        cpus = 2
        memory = '16 GB'
        time = '2h'
    }

    withName: 'MARK_DUPLICATES' {
        cpus = 2
        memory = '16 GB'
        time = '2h'
    }

    withName: 'BASE_RECALIBRATOR' {
        cpus = 2
        memory = '12 GB'
        time = '2h'
    }

    withName: 'APPLY_BQSR' {
        cpus = 2
        memory = '12 GB'
        time = '2h'
    }

    withName: 'JOINT_GENOMICSDB' { time = '1h' }



}



profiles {
    modules {
        process.beforeScript = 'module load bwa samtools gatk'
    }
    local {
        process.executor = 'local'
        process.beforeScript = 'module load bwa samtools gatk'
    }
    slurm {
        process.executor = 'slurm'
	process.queue = 'short'
    }
}
